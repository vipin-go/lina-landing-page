      "faq": {
        "kicker": "Your questions, answered",
        "heading": "Everything recruiters ask before Lina gets to work.",
        "body": "Clear guardrails. A simple input. Useful recruiting context in minutes.",
        "items": [
          {
            "question": "What does Lina need to get started?",
            "answer": "Paste a public funding announcement, job board listing, or company careers page. Lina works from that signal to find the company and its current open roles."
          },
          {
            "question": "Does Lina log in to LinkedIn or private systems?",
            "answer": "No. Lina only reads public pages and never asks for site credentials. If a source is private, she stops and tells you."
          },
          {
            "question": "Can Lina send outreach automatically?",
            "answer": "Only after approval. Lina drafts the message, shows you the company, roles, and sources, and waits for an explicit go-ahead before anything sends."
          },
          {
            "question": "What happens when a job signal is stale?",
            "answer": "Lina says so plainly. She does not invent openings, and she flags duplicate, stale, or irrelevant signals instead of turning them into leads."
          },
          {
            "question": "Which tools can Lina work with?",
            "answer": "The configured workflow supports Gmail and Slack, so drafts and notifications can fit naturally into the recruiter's existing day."
          }
        ]
      },
