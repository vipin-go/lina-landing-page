      ],
      "metrics": [
        {
          "id": "hours_removed",
          "label": "Repetitive work automated",
          "formula": "roles_per_month * hours_per_role * (automation_share / 100)",
          "format": "hours",
          "kind": "card",
          "layer": "operations",
          "productivity": "negative",
          "scalesWithPeriod": true,
          "scalesWithScenario": false,
          "note": "Negative productivity: operating burden removed."
        },
        {
          "id": "hours_returned",
          "label": "Capacity returned to the team",
          "formula": "hours_removed",
          "format": "hours",
          "kind": "card",
          "layer": "operations",
          "productivity": "positive",
          "scalesWithPeriod": true,
          "scalesWithScenario": false,
          "note": "Positive productivity: hours now available for better work."
        },
        {
          "id": "work_units",
          "label": "Roles sourced each month",
          "formula": "roles_per_month",
          "format": "integer",
          "kind": "card",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "unused_share",
          "label": "Unused capacity share",
          "formula": "100 - allocation_volume - allocation_billable - allocation_cost_reduction",
          "format": "percent",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": false,
          "scalesWithScenario": false
        },
        {
          "id": "volume_hours",
          "label": "Hours allocated to more volume",
          "formula": "hours_returned * (allocation_volume / 100)",
          "format": "hours",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "billable_hours",
          "label": "Hours allocated to higher-value work",
          "formula": "hours_returned * (allocation_billable / 100)",
          "format": "hours",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "cost_hours",
          "label": "Hours that become genuine cost reduction",
          "formula": "hours_returned * (allocation_cost_reduction / 100)",
          "format": "hours",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "unused_hours",
          "label": "Hours held as unused capacity",
          "formula": "hours_returned * (unused_share / 100)",
          "format": "hours",
          "kind": "hidden",
          "layer": "operations",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "monthly_tokens",
          "label": "Tokens per month",
          "formula": "hours_removed * tokens_per_unit",
          "format": "tokens",
          "kind": "hidden",
          "layer": "economics",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "model_cost",
          "label": "AI model cost (est.)",
          "formula": "(monthly_tokens * (1 - output_share / 100) / 1000000) * input_price + (monthly_tokens * (output_share / 100) / 1000000) * output_price",
          "format": "currency",
          "kind": "breakdown-cost",
          "layer": "economics",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "all_in_cost",
          "label": "All-in AI cost",
          "formula": "model_cost + license",
          "format": "currency",
          "kind": "summary-cost",
          "layer": "economics",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "cost_elimination",
          "label": "Genuine cost eliminated",
          "formula": "cost_hours * capacity_rate",
          "format": "currency",
          "kind": "breakdown-benefit",
          "layer": "value",
          "valueClass": "cost-elimination",
          "scalesWithPeriod": true,
          "scalesWithScenario": false,
          "note": "Overtime, contractors, or other spend you would actually stop."
        },
        {
          "id": "outsourced_cost_eliminated",
          "label": "Agency fees avoided",
          "formula": "roles_per_month * agency_fee * (automation_share / 100) * (allocation_cost_reduction / 100)",
          "format": "currency",
          "kind": "breakdown-benefit",
          "layer": "value",
          "valueClass": "cost-elimination",
          "scalesWithPeriod": true,
          "scalesWithScenario": false
        },
        {
          "id": "revenue_productivity",
          "label": "Contribution from higher-value work",
          "formula": "billable_hours * contribution_rate",
          "format": "currency",
          "kind": "breakdown-benefit",
          "layer": "value",
          "valueClass": "revenue-productivity",
          "scalesWithPeriod": true,
          "scalesWithScenario": true,
          "note": "Valued at contribution margin, not salary."
        },
        {
          "id": "throughput_value",
          "label": "Capacity to take more volume",
          "formula": "volume_hours * capacity_rate",
          "format": "currency",
          "kind": "breakdown-benefit",
          "layer": "value",
          "valueClass": "throughput",
          "scalesWithPeriod": true,
          "scalesWithScenario": true,
          "note": "Shadow price of extra throughput, not a payroll saving."
        },
        {
          "id": "error_value",
